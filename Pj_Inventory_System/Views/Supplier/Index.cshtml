@model IEnumerable<Pj_Inventory_System.Application.Dtos.SupplierDtos.SupplierDto>

@{
    ViewData["Title"] = "Supplier Page";
}

<style>
    .suppliers-page {
        color: #17263a;
    }

    .suppliers-page .page-header {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 24px;
    }

    .suppliers-page .page-title {
        margin: 0 0 6px;
        font-size: clamp(24px, 3vw, 30px);
        font-weight: 700;
        letter-spacing: -.6px;
    }

    .suppliers-page .page-description {
        margin: 0;
        color: #62738a;
        font-size: 14px;
        line-height: 1.6;
    }

    .suppliers-page .create-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 44px;
        padding: 10px 18px;
        border: 1px solid #7ce3d0;
        border-radius: 10px;
        background: #7ce3d0;
        color: #123a36;
        font-size: 14px;
        font-weight: 700;
    }

    .suppliers-page .create-button:hover,
    .suppliers-page .create-button:active {
        border-color: #65d3be;
        background: #65d3be;
        color: #123a36;
    }

    .suppliers-page .table-card {
        overflow: hidden;
        border: 1px solid #dde5ef;
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 6px 24px rgba(20, 35, 56, .04);
    }

    .suppliers-page .table-card-header {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 20px 24px;
        border-bottom: 1px solid #e6ecf3;
    }

    .suppliers-page .section-icon {
        display: grid;
        place-items: center;
        width: 40px;
        height: 40px;
        flex-shrink: 0;
        border-radius: 10px;
        background: #e5f7f2;
        color: #226a5c;
    }

    .suppliers-page .section-title {
        margin: 0;
        font-size: 16px;
        font-weight: 700;
    }

    .suppliers-page .suppliers-table {
        min-width: 640px;
        margin: 0;
        color: #17263a;
        vertical-align: middle;
    }

    .suppliers-page .suppliers-table > thead > tr > th {
        padding: 14px 24px;
        border-bottom: 1px solid #e6ecf3;
        background: #f8fafc;
        color: #52647c;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: .05em;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .suppliers-page .suppliers-table > tbody > tr > td {
        padding: 18px 24px;
        border-bottom: 1px solid #edf1f6;
        background: #fff;
        font-size: 14px;
    }

    .suppliers-page .suppliers-table > tbody > tr:last-child > td {
        border-bottom: 0;
    }

    .suppliers-page .suppliers-table > tbody > tr:hover > td {
        background: #f7fbfa;
    }

    .suppliers-page .supplier-id {
        color: #62738a;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }

    .suppliers-page .supplier-name {
        min-width: 160px;
        max-width: 320px;
        font-weight: 600;
        overflow-wrap: anywhere;
    }

    .suppliers-page .count-column {
        text-align: center;
    }

    .suppliers-page .product-count {
        display: inline-block;
        min-width: 38px;
        padding: 5px 10px;
        border: 1px solid #e1e8f1;
        border-radius: 8px;
        background: #f1f5f9;
        color: #42566f;
        font-size: 12px;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
    }

    .suppliers-page .actions-column {
        text-align: right;
    }

    .suppliers-page .row-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 8px;
    }

    .suppliers-page .action-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        min-height: 38px;
        padding: 8px 12px;
        border: 1px solid;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        line-height: 1.4;
        white-space: nowrap;
    }

    .suppliers-page .edit-button {
        border-color: #d6e1ef;
        background: #eef4fb;
        color: #285681;
    }

    .suppliers-page .edit-button:hover,
    .suppliers-page .edit-button:active {
        border-color: #b9cee5;
        background: #dfebf8;
        color: #20476c;
    }

    .suppliers-page .delete-button {
        border-color: #f1d4d9;
        background: #fff3f4;
        color: #a32638;
    }

    .suppliers-page .delete-button:hover,
    .suppliers-page .delete-button:active {
        border-color: #e7b4be;
        background: #fbe3e7;
        color: #8a2030;
    }

    .suppliers-page .btn:focus-visible,
    .suppliers-page .table-responsive:focus-visible {
        outline: 3px solid #278575;
        outline-offset: 3px;
        box-shadow: none;
    }

    @@media (max-width: 575.98px) {
        .suppliers-page .create-button {
            width: 100%;
        }

        .suppliers-page .table-card-header {
            padding: 16px;
        }

        .suppliers-page .suppliers-table > thead > tr > th,
        .suppliers-page .suppliers-table > tbody > tr > td {
            padding: 14px 16px;
        }
    }
</style>

<div class="suppliers-page">
    <div class="page-header">
        <div>
            <h1 class="page-title">Suppliers</h1>
            <p class="page-description">
                View and manage your suppliers.
            </p>
        </div>

        <a asp-action="Create" class="btn create-button">
            <i class="fas fa-plus" aria-hidden="true"></i>
            Create New Supplier
        </a>
    </div>

    <div class="table-card">
        <div class="table-card-header">
            <span class="section-icon" aria-hidden="true">
                <i class="fas fa-truck"></i>
            </span>

            <h2 class="section-title" id="suppliers-table-title">
                All Suppliers
            </h2>
        </div>

        <div class="table-responsive"
             role="region"
             aria-labelledby="suppliers-table-title"
             tabindex="0">
            <table class="table suppliers-table"
                   aria-labelledby="suppliers-table-title">
                <thead>
                    <tr>
                        <th scope="col">ID</th>
                        <th scope="col">Supplier Name</th>
                        <th scope="col" class="count-column">Products Count</th>
                        <th scope="col" class="actions-column">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var supplier in Model)
                    {
                        <tr>
                            <td class="supplier-id">@supplier.SupplierID</td>
                            <td class="supplier-name">@supplier.SupplierName</td>

                            <td class="count-column">
                                <span class="product-count">
                                    @supplier.ProductsCount
                                </span>
                            </td>

                            <td>
                                <div class="row-actions">
                                    <a asp-action="Edit"
                                       asp-route-uid="@supplier.UID"
                                       class="btn action-button edit-button">
                                        <i class="fas fa-pen" aria-hidden="true"></i>
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-uid="@supplier.UID"
                                       class="btn action-button delete-button">
                                        <i class="fas fa-trash-can" aria-hidden="true"></i>
                                        Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>