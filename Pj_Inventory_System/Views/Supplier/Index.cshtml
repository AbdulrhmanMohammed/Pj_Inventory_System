@model IEnumerable<Supplier>

@{
    ViewData["Title"] = "Supplier Page";
}

<div class="text-end mb-3">
    <a asp-action="Create" class="btn btn-primary">Create New Supplier</a>
</div>

<div class="container mt-2">
    <table class="table table-primary table-hover">
        <thead>
            <tr>
                <th>SupplierID</th>
                <th>SupplierName</th>
                <th>Products Count</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var supplier in Model)
            {
                <tr>
                    <td>@supplier.SupplierID</td>
                    <td>@supplier.SupplierName</td>
                    <td>@supplier.Products?.Count</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@supplier.SupplierID" class="btn btn-primary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@supplier.SupplierID" class="btn btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
