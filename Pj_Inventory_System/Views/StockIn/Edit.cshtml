@model Pj_Inventory_System.Dtos.StockInDtos.UpdateStockInDto

<form method="post" asp-action="Edit">

    <!-- مهم جداً: نرسل الـ UID -->
    <input type="hidden" asp-for="UID" />

    <!-- مهم جداً: نرسل الـ StockInID -->
    <input type="hidden" asp-for="StockInID" />

    <label>Product</label>
    <select asp-for="ProductID" class="form-control" asp-items="ViewBag.Products"></select>

    <label>Quantity</label>
    <input asp-for="Quantity" class="form-control" />

    <label>Date In</label>
    <input asp-for="DateIn" type="date" class="form-control" />

    <button type="submit" class="btn btn-primary mt-3">Save</button>

</form>
