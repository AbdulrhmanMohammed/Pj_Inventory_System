@model Pj_Inventory_System.Application.Dtos.StockInDtos.StockInDto

<style>
    .stock-in-delete-page {
        max-width: 760px;
        margin: 0 auto;
        color: #17263a;
    }

    .stock-in-delete-page .page-title {
        margin: 0 0 24px;
        font-size: clamp(24px, 3vw, 30px);
        font-weight: 700;
        letter-spacing: -.6px;
    }

    .stock-in-delete-page .delete-card {
        overflow: hidden;
        border: 1px solid #dde5ef;
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 6px 24px rgba(20, 35, 56, .04);
    }

    .stock-in-delete-page .delete-card-header {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 20px 24px;
        border-bottom: 1px solid #e6ecf3;
    }

    .stock-in-delete-page .section-icon {
        display: grid;
        place-items: center;
        width: 40px;
        height: 40px;
        flex-shrink: 0;
        border-radius: 10px;
        background: #fff0f2;
        color: #a32638;
    }

    .stock-in-delete-page .section-title {
        margin: 0;
        font-size: 16px;
        font-weight: 700;
    }

    .stock-in-delete-page .delete-form {
        margin: 0;
    }

    .stock-in-delete-page .delete-card-body {
        padding: 24px;
    }

    .stock-in-delete-page .delete-message {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin-bottom: 24px;
        padding: 16px;
        border: 1px solid #f1c5cb;
        border-radius: 10px;
        background: #fff3f4;
        color: #a32638;
        font-size: 14px;
        line-height: 1.7;
    }

    .stock-in-delete-page .message-icon {
        flex-shrink: 0;
        padding-top: 3px;
    }

    .stock-in-delete-page .field-group + .field-group {
        margin-top: 24px;
    }

    .stock-in-delete-page .form-label {
        margin-bottom: 10px;
        color: #24364d;
        font-size: 14px;
        font-weight: 600;
    }

    .stock-in-delete-page .form-control {
        min-height: 48px;
        padding: 12px 14px;
        border: 1px solid #d6dfeb;
        border-radius: 10px;
        background: #f1f5f9;
        color: #52647c;
        font-size: 15px;
    }

    .stock-in-delete-page .form-control:focus {
        border-color: #278575;
        box-shadow: 0 0 0 4px rgba(39, 133, 117, .12);
    }

    .stock-in-delete-page .delete-card-footer {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 12px;
        padding: 18px 24px;
        border-top: 1px solid #e6ecf3;
        background: #f8fafc;
    }

    .stock-in-delete-page .action-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-width: 120px;
        min-height: 44px;
        padding: 10px 20px;
        border: 1px solid;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 700;
    }

    .stock-in-delete-page .delete-button {
        border-color: #b52b40;
        background: #b52b40;
        color: #fff;
    }

    .stock-in-delete-page .delete-button:hover,
    .stock-in-delete-page .delete-button:active {
        border-color: #962235;
        background: #962235;
        color: #fff;
    }

    .stock-in-delete-page .cancel-button {
        border-color: #d6e1ef;
        background: #fff;
        color: #42566f;
    }

    .stock-in-delete-page .cancel-button:hover,
    .stock-in-delete-page .cancel-button:active {
        border-color: #bccbdd;
        background: #eef4fb;
        color: #24364d;
    }

    .stock-in-delete-page .action-button:focus-visible {
        outline: 3px solid #278575;
        outline-offset: 3px;
        box-shadow: none;
    }

    @@media (max-width: 575.98px) {
        .stock-in-delete-page .delete-card-header,
        .stock-in-delete-page .delete-card-body,
        .stock-in-delete-page .delete-card-footer {
            padding: 20px;
        }

        .stock-in-delete-page .action-button {
            width: 100%;
        }
    }
</style>

<div class="stock-in-delete-page">
    <h1 class="page-title">Delete Stock In</h1>

    <div class="delete-card">
        <div class="delete-card-header">
            <span class="section-icon" aria-hidden="true">
                <i class="fas fa-trash-can"></i>
            </span>

            <h2 class="section-title">Confirm Deletion</h2>
        </div>

        <form method="post"
              asp-action="DeleteConfirmed"
              class="delete-form">

            <input type="hidden" asp-for="UID" />

            <div class="delete-card-body">
                <div class="delete-message">
                    <span class="message-icon" aria-hidden="true">
                        <i class="fas fa-triangle-exclamation"></i>
                    </span>

                    <span>
                        Are you sure you want to delete this stock in record?
                    </span>
                </div>

                <div class="field-group">
                    <label for="stockInProduct" class="form-label">
                        Product
                    </label>

                    <input id="stockInProduct"
                           value="@Model.ProductName"
                           class="form-control"
                           readonly />
                </div>

                <div class="field-group">
                    <label asp-for="Quantity" class="form-label">
                        Quantity
                    </label>

                    <input asp-for="Quantity"
                           class="form-control"
                           readonly />
                </div>

                <div class="field-group">
                    <label for="stockInDate" class="form-label">
                        Date In
                    </label>

                    <input id="stockInDate"
                           value="@Model.DateIn.ToShortDateString()"
                           class="form-control"
                           readonly />
                </div>
            </div>

            <div class="delete-card-footer">
                <button type="submit"
                        class="btn action-button delete-button">
                    <i class="fas fa-trash-can" aria-hidden="true"></i>
                    Delete
                </button>

                <a asp-action="Index"
                   class="btn action-button cancel-button">
                    <i class="fas fa-xmark" aria-hidden="true"></i>
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>