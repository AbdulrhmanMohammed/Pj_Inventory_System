@model StockIn

<form method="post" asp-action="Delete">

    <!-- مهم جداً: نرسل الـ UID -->
    <input type="hidden" asp-for="UID" />

    <label>Product</label>
    <input value="@Model.Product.ProductName" class="form-control" readonly />

    <label>Quantity</label>
    <input asp-for="Quantity" class="form-control" readonly />

    <label>Date In</label>
    <input value="@Model.DateIn.ToShortDateString()" class="form-control" readonly />

    <button type="submit" class="btn btn-danger mt-3">Delete</button>
    <a asp-action="Index" class="btn btn-secondary mt-3">Cancel</a>

</form>
