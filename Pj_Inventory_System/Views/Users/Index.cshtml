@model IEnumerable<User>

@{
    ViewData["Title"] = "Users";
    int counter = 1;
}

<style>
    .users-page {
        color: #17263a;
    }

    .users-page .page-header {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 24px;
    }

    .users-page .page-title {
        margin: 0 0 6px;
        font-size: clamp(24px, 3vw, 30px);
        font-weight: 700;
        letter-spacing: -.6px;
    }

    .users-page .page-description {
        margin: 0;
        color: #62738a;
        font-size: 14px;
        line-height: 1.6;
    }

    .users-page .table-card {
        overflow: hidden;
        border: 1px solid #dde5ef;
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 6px 24px rgba(20, 35, 56, .04);
    }

    .users-page .table-card-header {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 20px 24px;
        border-bottom: 1px solid #e6ecf3;
    }

    .users-page .section-icon,
    .user-modal .section-icon {
        display: grid;
        place-items: center;
        width: 40px;
        height: 40px;
        flex-shrink: 0;
        border-radius: 10px;
        background: #e5f7f2;
        color: #226a5c;
    }

    .users-page .section-title {
        margin: 0;
        font-size: 16px;
        font-weight: 700;
    }

    .users-page .users-table {
        min-width: 1100px;
        margin: 0;
        color: #17263a;
        vertical-align: middle;
    }

    .users-page .users-table > thead > tr > th {
        padding: 14px 20px;
        border-bottom: 1px solid #e6ecf3;
        background: #f8fafc;
        color: #52647c;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: .05em;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .users-page .users-table > tbody > tr > td {
        padding: 18px 20px;
        border-bottom: 1px solid #edf1f6;
        background: #fff;
        font-size: 14px;
        overflow-wrap: anywhere;
    }

    .users-page .users-table > tbody > tr:last-child > td {
        border-bottom: 0;
    }

    .users-page .users-table > tbody > tr:hover > td {
        background: #f7fbfa;
    }

    .users-page .number-cell {
        color: #62738a;
        font-variant-numeric: tabular-nums;
    }

    .users-page .user-name {
        min-width: 140px;
        max-width: 240px;
        font-weight: 600;
    }

    .users-page .username-cell,
    .users-page .email-cell {
        max-width: 260px;
        color: #52647c;
    }

    .users-page .actions-column {
        text-align: right;
    }

    .users-page .row-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 8px;
    }

    .users-page .btn,
    .user-modal .modal-footer .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 44px;
        padding: 10px 18px;
        border: 1px solid;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 600;
    }

    .users-page .row-actions .btn {
        min-height: 38px;
        padding: 8px 12px;
        border-radius: 8px;
        font-size: 13px;
        white-space: nowrap;
    }

    .users-page .create-button,
    .user-modal .save-button {
        border-color: #7ce3d0;
        background: #7ce3d0;
        color: #123a36;
    }

    .users-page .create-button:hover,
    .user-modal .save-button:hover {
        border-color: #65d3be;
        background: #65d3be;
        color: #123a36;
    }

    .users-page .edit-button {
        border-color: #d6e1ef;
        background: #eef4fb;
        color: #285681;
    }

    .users-page .edit-button:hover {
        border-color: #b9cee5;
        background: #dfebf8;
        color: #20476c;
    }

    .users-page .delete-button {
        border-color: #f1d4d9;
        background: #fff3f4;
        color: #a32638;
    }

    .users-page .delete-button:hover {
        border-color: #e7b4be;
        background: #fbe3e7;
        color: #8a2030;
    }

    .users-page .roles-button {
        border-color: #c8e8df;
        background: #e5f7f2;
        color: #226a5c;
    }

    .users-page .roles-button:hover {
        border-color: #a6d7ca;
        background: #d4efe6;
        color: #195345;
    }

    .users-page .files-button {
        border-color: #dde5ef;
        background: #f1f5f9;
        color: #42566f;
    }

    .users-page .files-button:hover {
        border-color: #bccbdd;
        background: #e5ecf4;
        color: #24364d;
    }

    .user-modal .modal-content {
        border: 1px solid #dde5ef;
        border-radius: 16px;
        background: #fff;
        color: #17263a;
        box-shadow: 0 20px 60px rgba(20, 35, 56, .18);
    }

    .user-modal form {
        margin: 0;
    }

    .user-modal .modal-header {
        gap: 12px;
        padding: 20px 24px;
        border-bottom: 1px solid #e6ecf3;
    }

    .user-modal .modal-title {
        margin: 0;
        font-size: 18px;
        font-weight: 700;
    }

    .user-modal .modal-body {
        padding: 24px;
        overflow-wrap: anywhere;
    }

    .user-modal .field-group + .field-group {
        margin-top: 20px;
    }

    .user-modal .form-label {
        margin-bottom: 8px;
        color: #24364d;
        font-size: 14px;
        font-weight: 600;
    }

    .user-modal .form-control {
        min-height: 48px;
        padding: 12px 14px;
        border: 1px solid #d6dfeb;
        border-radius: 10px;
        background: #fbfcfe;
        color: #17263a;
        font-size: 15px;
    }

    .user-modal .form-control:focus {
        border-color: #278575;
        background: #fff;
        box-shadow: 0 0 0 4px rgba(39, 133, 117, .12);
    }

    .user-modal .field-help {
        display: block;
        margin-top: 8px;
        color: #62738a;
        font-size: 12px;
        line-height: 1.6;
    }

    .user-modal .modal-footer {
        gap: 8px;
        padding: 18px 24px;
        border-top: 1px solid #e6ecf3;
        border-radius: 0 0 16px 16px;
        background: #f8fafc;
    }

    .user-modal .cancel-button {
        border-color: #d6e1ef;
        background: #fff;
        color: #42566f;
    }

    .user-modal .cancel-button:hover {
        border-color: #bccbdd;
        background: #eef4fb;
        color: #24364d;
    }

    .user-modal .confirm-delete-button {
        border-color: #b52b40;
        background: #b52b40;
        color: #fff;
    }

    .user-modal .confirm-delete-button:hover {
        border-color: #962235;
        background: #962235;
        color: #fff;
    }

    .user-modal .delete-icon {
        background: #fff0f2;
        color: #a32638;
    }

    .user-modal .delete-message {
        padding: 16px;
        border: 1px solid #f1c5cb;
        border-radius: 10px;
        background: #fff3f4;
        color: #a32638;
        font-size: 14px;
        line-height: 1.8;
    }

    .user-modal .delete-message p {
        margin: 0;
    }

    .user-modal .delete-message p + p {
        margin-top: 8px;
        font-weight: 600;
    }

    .users-page .btn:focus-visible,
    .users-page .table-responsive:focus-visible,
    .user-modal .btn:focus-visible,
    .user-modal .btn-close:focus-visible {
        outline: 3px solid #278575;
        outline-offset: 3px;
        box-shadow: none;
    }

    @@media (max-width: 575.98px) {
        .users-page .create-button {
            width: 100%;
        }

        .users-page .table-card-header,
        .user-modal .modal-header,
        .user-modal .modal-body,
        .user-modal .modal-footer {
            padding: 16px;
        }

        .users-page .users-table > thead > tr > th,
        .users-page .users-table > tbody > tr > td {
            padding: 14px 16px;
        }

        .user-modal .modal-footer .btn {
            flex: 1 1 120px;
        }
    }
</style>

<div class="users-page">
    <div class="page-header">
        <div>
            <h1 class="page-title">Users</h1>
            <p class="page-description">
                Manage users, roles, and files.
            </p>
        </div>

        <button type="button"
                class="btn create-button"
                data-bs-toggle="modal"
                data-bs-target="#createModal">
            <i class="fas fa-plus" aria-hidden="true"></i>
            Create User
        </button>
    </div>

    <div class="table-card">
        <div class="table-card-header">
            <span class="section-icon" aria-hidden="true">
                <i class="fas fa-users"></i>
            </span>

            <h2 class="section-title" id="users-table-title">
                Users List
            </h2>
        </div>

        <div class="table-responsive"
             role="region"
             aria-labelledby="users-table-title"
             tabindex="0">
            <table class="table users-table"
                   aria-labelledby="users-table-title">
                <thead>
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">ID</th>
                        <th scope="col">Name</th>
                        <th scope="col">Username</th>
                        <th scope="col">Email</th>
                        <th scope="col" class="actions-column">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="number-cell">@counter</td>
                            <td class="number-cell">@user.Id</td>
                            <td class="user-name">@user.Name</td>
                            <td class="username-cell">@user.Username</td>
                            <td class="email-cell">@user.Email</td>

                            <td>
                                <div class="row-actions">
                                    <button type="button"
                                            class="btn edit-button"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editModal-@user.UID">
                                        <i class="fas fa-pen" aria-hidden="true"></i>
                                        Edit
                                    </button>

                                    <button type="button"
                                            class="btn delete-button"
                                            data-bs-toggle="modal"
                                            data-bs-target="#deleteModal-@user.UID">
                                        <i class="fas fa-trash-can" aria-hidden="true"></i>
                                        Delete
                                    </button>

                                    <a asp-controller="Users"
                                       asp-action="ManageRoles"
                                       asp-route-uid="@user.UID"
                                       class="btn roles-button">
                                        <i class="fas fa-user-shield" aria-hidden="true"></i>
                                        Roles
                                    </a>

                                    <a asp-controller="Users"
                                       asp-action="ManageFiles"
                                       asp-route-uid="@user.UID"
                                       class="btn files-button">
                                        <i class="fas fa-folder-open" aria-hidden="true"></i>
                                        Files
                                    </a>
                                </div>
                            </td>
                        </tr>

                        counter++;
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Create User Modal -->
<div class="modal fade user-modal"
     id="createModal"
     tabindex="-1"
     aria-labelledby="createUserTitle"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="Create" method="post">
                <div class="modal-header">
                    <span class="section-icon" aria-hidden="true">
                        <i class="fas fa-user-plus"></i>
                    </span>

                    <h2 class="modal-title" id="createUserTitle">
                        Create User
                    </h2>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>
                </div>

                <div class="modal-body">
                    <div class="field-group">
                        <label for="createUserName" class="form-label">Name</label>
                        <input type="text"
                               id="createUserName"
                               name="Name"
                               class="form-control"
                               required />
                    </div>

                    <div class="field-group">
                        <label for="createUsername" class="form-label">Username</label>
                        <input type="text"
                               id="createUsername"
                               name="Username"
                               class="form-control"
                               required />
                    </div>

                    <div class="field-group">
                        <label for="createUserEmail" class="form-label">Email</label>
                        <input type="email"
                               id="createUserEmail"
                               name="Email"
                               class="form-control"
                               required />
                    </div>

                    <div class="field-group">
                        <label for="createUserPassword" class="form-label">Password</label>
                        <input type="password"
                               id="createUserPassword"
                               name="Password"
                               class="form-control"
                               required />
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn cancel-button"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit" class="btn save-button">
                        <i class="fas fa-plus" aria-hidden="true"></i>
                        Create
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@foreach (var user in Model)
{
    <!-- Edit User Modal -->
    <div class="modal fade user-modal"
         id="editModal-@user.UID"
         tabindex="-1"
         aria-labelledby="editUserTitle-@user.UID"
         aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form asp-action="Edit" method="post">
                    <input type="hidden" name="UID" value="@user.UID" />

                    <div class="modal-header">
                        <span class="section-icon" aria-hidden="true">
                            <i class="fas fa-user-pen"></i>
                        </span>

                        <h2 class="modal-title" id="editUserTitle-@user.UID">
                            Edit User
                        </h2>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Close">
                        </button>
                    </div>

                    <div class="modal-body">
                        <div class="field-group">
                            <label for="editUserName-@user.UID" class="form-label">
                                Name
                            </label>
                            <input type="text"
                                   id="editUserName-@user.UID"
                                   name="Name"
                                   value="@user.Name"
                                   class="form-control"
                                   required />
                        </div>

                        <div class="field-group">
                            <label for="editUsername-@user.UID" class="form-label">
                                Username
                            </label>
                            <input type="text"
                                   id="editUsername-@user.UID"
                                   name="Username"
                                   value="@user.Username"
                                   class="form-control"
                                   required />
                        </div>

                        <div class="field-group">
                            <label for="editUserEmail-@user.UID" class="form-label">
                                Email
                            </label>
                            <input type="email"
                                   id="editUserEmail-@user.UID"
                                   name="Email"
                                   value="@user.Email"
                                   class="form-control"
                                   required />
                        </div>

                        <div class="field-group">
                            <label for="editUserPassword-@user.UID" class="form-label">
                                New Password
                            </label>
                            <input type="password"
                                   id="editUserPassword-@user.UID"
                                   name="Password"
                                   class="form-control"
                                   placeholder="Leave empty to keep old password"
                                   aria-describedby="passwordHelp-@user.UID" />
                            <small class="field-help" id="passwordHelp-@user.UID">
                                Leave empty if you don't want to change the password.
                            </small>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button"
                                class="btn cancel-button"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <button type="submit" class="btn save-button">
                            <i class="fas fa-check" aria-hidden="true"></i>
                            Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Delete User Modal -->
    <div class="modal fade user-modal"
         id="deleteModal-@user.UID"
         tabindex="-1"
         aria-labelledby="deleteUserTitle-@user.UID"
         aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form asp-action="Delete" method="post">
                    <input type="hidden" name="UID" value="@user.UID" />

                    <div class="modal-header">
                        <span class="section-icon delete-icon" aria-hidden="true">
                            <i class="fas fa-trash-can"></i>
                        </span>

                        <h2 class="modal-title" id="deleteUserTitle-@user.UID">
                            Delete User
                        </h2>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Close">
                        </button>
                    </div>

                    <div class="modal-body">
                        <div class="delete-message">
                            <p>
                                Are you sure you want to delete
                                <strong>@user.Name</strong>?
                            </p>
                            <p>This action cannot be undone.</p>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button"
                                class="btn cancel-button"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <button type="submit" class="btn confirm-delete-button">
                            <i class="fas fa-trash-can" aria-hidden="true"></i>
                            Delete
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}