@using Pj_Inventory_System.Application.Dtos
@model UserRolesVM

@{
    ViewData["Title"] = "Manage User Roles";
}

<style>
    .user-roles-page {
        max-width: 900px;
        margin: 0 auto;
        color: #17263a;
    }

    .user-roles-page .page-header {
        margin-bottom: 24px;
    }

    .user-roles-page .page-title {
        margin: 0 0 8px;
        font-size: clamp(24px, 3vw, 30px);
        font-weight: 700;
        letter-spacing: -.6px;
    }

    .user-roles-page .page-description {
        margin: 0;
        color: #62738a;
        font-size: 14px;
        line-height: 1.6;
    }

    .user-roles-page .roles-card {
        overflow: hidden;
        border: 1px solid #dde5ef;
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 6px 24px rgba(20, 35, 56, .04);
    }

    .user-roles-page .roles-card-header {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 20px 24px;
        border-bottom: 1px solid #e6ecf3;
    }

    .user-roles-page .section-icon {
        display: grid;
        place-items: center;
        width: 40px;
        height: 40px;
        flex-shrink: 0;
        border-radius: 10px;
        background: #e5f7f2;
        color: #226a5c;
    }

    .user-roles-page .user-heading {
        min-width: 0;
    }

    .user-roles-page .user-label {
        margin-bottom: 4px;
        color: #62738a;
        font-size: 12px;
    }

    .user-roles-page .user-name {
        margin: 0;
        font-size: 17px;
        font-weight: 700;
        overflow-wrap: anywhere;
    }

    .user-roles-page .roles-form {
        margin: 0;
    }

    .user-roles-page .roles-card-body {
        padding: 28px 24px;
    }

    .user-roles-page .roles-fieldset {
        min-width: 0;
        margin: 0;
        padding: 0;
        border: 0;
    }

    .user-roles-page .roles-legend {
        float: none;
        width: auto;
        margin-bottom: 18px;
        font-size: 14px;
        font-weight: 600;
    }

    .user-roles-page .roles-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
    }

    .user-roles-page .role-option {
        position: relative;
        min-width: 0;
    }

    .user-roles-page .role-checkbox {
        position: absolute;
        z-index: 1;
        top: 50%;
        left: 16px;
        width: 20px;
        height: 20px;
        margin: 0;
        transform: translateY(-50%);
        border-color: #a9bbce;
        cursor: pointer;
    }

    .user-roles-page .role-option-label {
        display: flex;
        align-items: center;
        min-height: 62px;
        height: 100%;
        padding: 16px 16px 16px 48px;
        border: 1px solid #dde5ef;
        border-radius: 10px;
        background: #fbfcfe;
        color: #42566f;
        font-size: 14px;
        font-weight: 500;
        line-height: 1.6;
        overflow-wrap: anywhere;
        cursor: pointer;
    }

    .user-roles-page .role-option-label:hover {
        border-color: #a6d7ca;
        background: #f3faf7;
    }

    .user-roles-page .role-checkbox:checked {
        border-color: #278575;
        background-color: #278575;
    }

    .user-roles-page .role-checkbox:checked ~ .role-option-label {
        border-color: #a6d7ca;
        background: #e5f7f2;
        color: #195345;
        font-weight: 600;
    }

    .user-roles-page .role-checkbox:focus {
        border-color: #278575;
        box-shadow: 0 0 0 4px rgba(39, 133, 117, .12);
    }

    .user-roles-page .role-checkbox:focus-visible ~ .role-option-label {
        outline: 2px solid #278575;
        outline-offset: 2px;
    }

    .user-roles-page .roles-card-footer {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 12px;
        padding: 18px 24px;
        border-top: 1px solid #e6ecf3;
        background: #f8fafc;
    }

    .user-roles-page .action-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 44px;
        padding: 10px 20px;
        border: 1px solid;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 700;
    }

    .user-roles-page .save-button {
        border-color: #7ce3d0;
        background: #7ce3d0;
        color: #123a36;
    }

    .user-roles-page .save-button:hover,
    .user-roles-page .save-button:active {
        border-color: #65d3be;
        background: #65d3be;
        color: #123a36;
    }

    .user-roles-page .back-button {
        border-color: #d6e1ef;
        background: #fff;
        color: #42566f;
    }

    .user-roles-page .back-button:hover,
    .user-roles-page .back-button:active {
        border-color: #bccbdd;
        background: #eef4fb;
        color: #24364d;
    }

    .user-roles-page .action-button:focus-visible {
        outline: 3px solid #278575;
        outline-offset: 3px;
        box-shadow: none;
    }

    @@media (max-width: 575.98px) {
        .user-roles-page .roles-card-header,
        .user-roles-page .roles-card-body,
        .user-roles-page .roles-card-footer {
            padding: 20px;
        }

        .user-roles-page .roles-grid {
            grid-template-columns: minmax(0, 1fr);
        }

        .user-roles-page .action-button {
            width: 100%;
        }
    }
</style>

<div class="user-roles-page">
    <div class="page-header">
        <h1 class="page-title">@ViewData["Title"]</h1>
        <p class="page-description">
            Select the roles to assign to this user.
        </p>
    </div>

    <div class="roles-card">
        <div class="roles-card-header">
            <span class="section-icon" aria-hidden="true">
                <i class="fas fa-user-shield"></i>
            </span>

            <div class="user-heading">
                <div class="user-label">User</div>
                <h2 class="user-name">@Model.UserName</h2>
            </div>
        </div>

        <form asp-action="ManageRoles"
              method="post"
              class="roles-form">

            <input type="hidden" asp-for="UserId" />

            <div class="roles-card-body">
                <fieldset class="roles-fieldset">
                    <legend class="roles-legend">
                        Available Roles
                    </legend>

                    <div class="roles-grid">
                        @for (int i = 0; i < Model.Roles.Count; i++)
                        {
                            <div class="role-option">
                                <input type="hidden"
                                       asp-for="Roles[i].RoleId" />

                                <input class="form-check-input role-checkbox"
                                       asp-for="Roles[i].IsSelected" />

                                <label class="role-option-label"
                                       asp-for="Roles[i].IsSelected">
                                    @Model.Roles[i].RoleName
                                </label>
                            </div>
                        }
                    </div>
                </fieldset>
            </div>

            <div class="roles-card-footer">
                <button type="submit"
                        class="btn action-button save-button">
                    <i class="fas fa-check" aria-hidden="true"></i>
                    Save Roles
                </button>

                <a asp-action="Index"
                   class="btn action-button back-button">
                    <i class="fas fa-arrow-left" aria-hidden="true"></i>
                    Back
                </a>
            </div>
        </form>
    </div>
</div>