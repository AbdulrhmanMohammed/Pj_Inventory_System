@model Pj_Inventory_System.Application.Dtos.OrderDtos.OrderDto

@{
    ViewData["Title"] = "Edit Order";
}

<h2>Edit Order</h2>

<form asp-action="Edit">

    <input asp-for="OrderID" hidden />
    <input asp-for="UID" hidden />
    <input asp-for="CreatedAt" hidden />

    <div class="mb-3">
        <label asp-for="UserId" class="form-label"></label>
        <input asp-for="UserId" class="form-control" readonly />
    </div>

    <div class="mb-3">
        <label asp-for="Status" class="form-label"></label>

        <select asp-for="Status"
                asp-items="ViewBag.Statuses"
                class="form-control">
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="TotalAmount" class="form-label"></label>
        <input asp-for="TotalAmount"
               class="form-control" />
    </div>

    <button type="submit"
            class="btn btn-primary">
        Save Changes
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Back
    </a>

</form>