@model Pj_Inventory_System.Application.Dtos.OrderDtos.OrderDto

@{
    ViewData["Title"] = "Edit Order";
}

<style>
    .order-edit-page {
        max-width: 760px;
        margin: 0 auto;
        color: #17263a;
    }

    .order-edit-page .page-header {
        margin-bottom: 24px;
    }

    .order-edit-page .page-title {
        margin: 0 0 8px;
        font-size: clamp(24px, 3vw, 30px);
        font-weight: 700;
        letter-spacing: -.6px;
    }

    .order-edit-page .page-description {
        margin: 0;
        color: #62738a;
        font-size: 14px;
        line-height: 1.6;
    }

    .order-edit-page .edit-card {
        overflow: hidden;
        border: 1px solid #dde5ef;
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 6px 24px rgba(20, 35, 56, .04);
    }

    .order-edit-page .edit-card-header {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 20px 24px;
        border-bottom: 1px solid #e6ecf3;
    }

    .order-edit-page .section-icon {
        display: grid;
        place-items: center;
        width: 40px;
        height: 40px;
        flex-shrink: 0;
        border-radius: 10px;
        background: #e5f7f2;
        color: #226a5c;
    }

    .order-edit-page .section-title {
        margin: 0;
        font-size: 16px;
        font-weight: 700;
    }

    .order-edit-page .edit-form {
        margin: 0;
    }

    .order-edit-page .edit-card-body {
        padding: 28px 24px;
    }

    .order-edit-page .field-group + .field-group {
        margin-top: 24px;
    }

    .order-edit-page .form-label {
        margin-bottom: 10px;
        color: #24364d;
        font-size: 14px;
        font-weight: 600;
    }

    .order-edit-page .form-control,
    .order-edit-page .form-select {
        min-height: 48px;
        border: 1px solid #d6dfeb;
        border-radius: 10px;
        background-color: #fbfcfe;
        color: #17263a;
        font-size: 15px;
    }

    .order-edit-page .form-control {
        padding: 12px 14px;
    }

    .order-edit-page .form-select {
        padding: 12px 40px 12px 14px;
    }

    .order-edit-page .form-control:focus,
    .order-edit-page .form-select:focus {
        border-color: #278575;
        background-color: #fff;
        box-shadow: 0 0 0 4px rgba(39, 133, 117, .12);
    }

    .order-edit-page .form-control[readonly] {
        background-color: #f1f5f9;
        color: #52647c;
    }

    .order-edit-page .input-validation-error {
        border-color: #b6384c;
    }

    .order-edit-page .edit-card-footer {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: flex-end;
        gap: 12px;
        padding: 18px 24px;
        border-top: 1px solid #e6ecf3;
        background: #f8fafc;
    }

    .order-edit-page .action-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 44px;
        padding: 10px 20px;
        border: 1px solid;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 700;
    }

    .order-edit-page .save-button {
        border-color: #7ce3d0;
        background: #7ce3d0;
        color: #123a36;
    }

    .order-edit-page .save-button:hover,
    .order-edit-page .save-button:active {
        border-color: #65d3be;
        background: #65d3be;
        color: #123a36;
    }

    .order-edit-page .back-button {
        border-color: #d6e1ef;
        background: #fff;
        color: #42566f;
    }

    .order-edit-page .back-button:hover,
    .order-edit-page .back-button:active {
        border-color: #bccbdd;
        background: #eef4fb;
        color: #24364d;
    }

    .order-edit-page .action-button:focus-visible {
        outline: 3px solid #278575;
        outline-offset: 3px;
        box-shadow: none;
    }

    @@media (max-width: 575.98px) {
        .order-edit-page .edit-card-header,
        .order-edit-page .edit-card-body,
        .order-edit-page .edit-card-footer {
            padding: 20px;
        }

        .order-edit-page .action-button {
            width: 100%;
        }
    }
</style>

<div class="order-edit-page">
    <div class="page-header">
        <h1 class="page-title">@ViewData["Title"]</h1>
        <p class="page-description">
            Update the order status and total amount.
        </p>
    </div>

    <div class="edit-card">
        <div class="edit-card-header">
            <span class="section-icon" aria-hidden="true">
                <i class="fas fa-clipboard-list"></i>
            </span>

            <h2 class="section-title">Order Details</h2>
        </div>

        <form asp-action="Edit" class="edit-form">

            <input asp-for="OrderID" hidden />
            <input asp-for="UID" hidden />
            <input asp-for="CreatedAt" hidden />

            <div class="edit-card-body">
                <div class="field-group">
                    <label asp-for="UserId" class="form-label"></label>
                    <input asp-for="UserId"
                           class="form-control"
                           readonly />
                </div>

                <div class="field-group">
                    <label asp-for="Status" class="form-label"></label>
                    <select asp-for="Status"
                            asp-items="ViewBag.Statuses"
                            class="form-select">
                    </select>
                </div>

                <div class="field-group">
                    <label asp-for="TotalAmount" class="form-label"></label>
                    <input asp-for="TotalAmount"
                           class="form-control" />
                </div>
            </div>

            <div class="edit-card-footer">
                <button type="submit"
                        class="btn action-button save-button">
                    <i class="fas fa-check" aria-hidden="true"></i>
                    Save Changes
                </button>

                <a asp-action="Index"
                   class="btn action-button back-button">
                    <i class="fas fa-arrow-left" aria-hidden="true"></i>
                    Back
                </a>
            </div>

        </form>
    </div>
</div>