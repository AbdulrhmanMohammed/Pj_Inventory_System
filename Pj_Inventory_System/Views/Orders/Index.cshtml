@model IEnumerable<Pj_Inventory_System.Application.Dtos.OrderDtos.OrderDto>

@{
    ViewData["Title"] = "Orders";
}

<style>
    .orders-page {
        color: #17263a;
    }

    .orders-page .page-header {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 24px;
    }

    .orders-page .page-title {
        margin: 0 0 6px;
        font-size: clamp(24px, 3vw, 30px);
        font-weight: 700;
        letter-spacing: -.6px;
    }

    .orders-page .page-description {
        margin: 0;
        color: #62738a;
        font-size: 14px;
    }

    .orders-page .create-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 44px;
        padding: 10px 18px;
        border: 1px solid #7ce3d0;
        border-radius: 10px;
        background: #7ce3d0;
        color: #123a36;
        font-size: 14px;
        font-weight: 700;
    }

    .orders-page .create-button:hover {
        border-color: #65d3be;
        background: #65d3be;
        color: #123a36;
    }

    .orders-page .table-card {
        overflow: hidden;
        border: 1px solid #dde5ef;
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 6px 24px rgba(20, 35, 56, .04);
    }

    .orders-page .table-card-header {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 20px 24px;
        border-bottom: 1px solid #e6ecf3;
    }

    .orders-page .table-icon {
        display: grid;
        place-items: center;
        width: 40px;
        height: 40px;
        flex-shrink: 0;
        border-radius: 10px;
        background: #e5f7f2;
        color: #226a5c;
    }

    .orders-page .table-card-title {
        margin: 0;
        font-size: 16px;
        font-weight: 700;
    }

    .orders-page .orders-table {
        min-width: 960px;
        margin: 0;
        color: #17263a;
        vertical-align: middle;
    }

    .orders-page .orders-table > thead > tr > th {
        padding: 14px 24px;
        border-bottom: 1px solid #e6ecf3;
        background: #f8fafc;
        color: #52647c;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: .05em;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .orders-page .orders-table > tbody > tr > td {
        padding: 18px 24px;
        border-bottom: 1px solid #edf1f6;
        background: #fff;
        font-size: 14px;
    }

    .orders-page .orders-table > tbody > tr:last-child > td {
        border-bottom: 0;
    }

    .orders-page .orders-table > tbody > tr:hover > td {
        background: #f7fbfa;
    }

    .orders-page .order-id {
        font-weight: 700;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }

    .orders-page .user-id {
        max-width: 240px;
        color: #62738a;
        overflow-wrap: anywhere;
    }

    .orders-page .status-badge {
        display: inline-block;
        padding: 5px 10px;
        border: 1px solid #d6e1ef;
        border-radius: 8px;
        background: #eef4fb;
        color: #285681;
        font-size: 12px;
        font-weight: 600;
        line-height: 1.5;
    }

    .orders-page .amount-column {
        text-align: right;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }

    .orders-page td.amount-column {
        font-weight: 700;
    }

    .orders-page .date-column {
        color: #62738a;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }

    .orders-page .actions-column {
        text-align: right;
    }

    .orders-page .row-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 8px;
    }

    .orders-page .action-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        min-height: 38px;
        padding: 8px 12px;
        border: 1px solid;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        line-height: 1.4;
        white-space: nowrap;
    }

    .orders-page .edit-button {
        border-color: #d6e1ef;
        background: #eef4fb;
        color: #285681;
    }

    .orders-page .edit-button:hover {
        border-color: #b9cee5;
        background: #dfebf8;
        color: #20476c;
    }

    .orders-page .details-button {
        border-color: #c8e8df;
        background: #e5f7f2;
        color: #226a5c;
    }

    .orders-page .details-button:hover {
        border-color: #a6d7ca;
        background: #d4efe6;
        color: #195345;
    }

    .orders-page .delete-button {
        border-color: #f1d4d9;
        background: #fff3f4;
        color: #a32638;
    }

    .orders-page .delete-button:hover {
        border-color: #e7b4be;
        background: #fbe3e7;
        color: #8a2030;
    }

    .orders-page .btn:focus-visible,
    .orders-page .table-responsive:focus-visible {
        outline: 3px solid #278575;
        outline-offset: 3px;
        box-shadow: none;
    }

    @@media (max-width: 575.98px) {
        .orders-page .create-button {
            width: 100%;
        }

        .orders-page .table-card-header {
            padding: 16px;
        }

        .orders-page .orders-table > thead > tr > th,
        .orders-page .orders-table > tbody > tr > td {
            padding: 14px 16px;
        }
    }
</style>

<div class="orders-page">
    <div class="page-header">
        <div>
            <h1 class="page-title">Orders</h1>
            <p class="page-description">
                View and manage your orders.
            </p>
        </div>

        <a asp-action="Create" class="btn create-button">
            <i class="fas fa-plus" aria-hidden="true"></i>
            Create New Order
        </a>
    </div>

    <div class="table-card">
        <div class="table-card-header">
            <span class="table-icon" aria-hidden="true">
                <i class="fas fa-clipboard-list"></i>
            </span>

            <h2 class="table-card-title" id="orders-table-title">
                Orders List
            </h2>
        </div>

        <div class="table-responsive"
             role="region"
             aria-labelledby="orders-table-title"
             tabindex="0">
            <table class="table orders-table"
                   aria-labelledby="orders-table-title">
                <thead>
                    <tr>
                        <th scope="col">Order ID</th>
                        <th scope="col">User ID</th>
                        <th scope="col">Status</th>
                        <th scope="col" class="amount-column">Total Amount</th>
                        <th scope="col">Created At</th>
                        <th scope="col" class="actions-column">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="order-id">@item.OrderID</td>
                            <td class="user-id">@item.UserId</td>
                            <td>
                                <span class="status-badge">@item.Status</span>
                            </td>
                            <td class="amount-column">@item.TotalAmount</td>
                            <td class="date-column">@item.CreatedAt</td>

                            <td>
                                <div class="row-actions">
                                    <a asp-action="Edit"
                                       asp-route-id="@item.OrderID"
                                       class="btn action-button edit-button">
                                        <i class="fas fa-pen" aria-hidden="true"></i>
                                        Edit
                                    </a>

                                    <a asp-action="Details"
                                       asp-route-id="@item.OrderID"
                                       class="btn action-button details-button">
                                        <i class="fas fa-eye" aria-hidden="true"></i>
                                        Details
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.OrderID"
                                       class="btn action-button delete-button">
                                        <i class="fas fa-trash-can" aria-hidden="true"></i>
                                        Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>