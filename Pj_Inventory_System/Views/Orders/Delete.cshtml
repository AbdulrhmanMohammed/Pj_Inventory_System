@model Pj_Inventory_System.Application.Dtos.OrderDtos.OrderDto

<h2>Delete Order</h2>

<div class="alert alert-danger">
    Are you sure you want to delete this order?
</div>

<dl class="row">

    <dt class="col-sm-3">
        Order ID
    </dt>

    <dd class="col-sm-9">
        @Model.OrderID
    </dd>

    <dt class="col-sm-3">
        Status
    </dt>

    <dd class="col-sm-9">
        @Model.Status
    </dd>

</dl>

<form asp-action="Delete">

    <input asp-for="OrderID" hidden />

    <button class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>