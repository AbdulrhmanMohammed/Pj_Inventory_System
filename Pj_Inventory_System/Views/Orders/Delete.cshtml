@model Pj_Inventory_System.Application.Dtos.OrderDtos.OrderDto

<style>
    .order-delete-page {
        max-width: 760px;
        margin: 0 auto;
        color: #17263a;
    }

    .order-delete-page .page-title {
        margin: 0 0 24px;
        font-size: clamp(24px, 3vw, 30px);
        font-weight: 700;
        letter-spacing: -.6px;
    }

    .order-delete-page .delete-card {
        overflow: hidden;
        border: 1px solid #dde5ef;
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 6px 24px rgba(20, 35, 56, .04);
    }

    .order-delete-page .delete-card-header {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 20px 24px;
        border-bottom: 1px solid #e6ecf3;
    }

    .order-delete-page .section-icon {
        display: grid;
        place-items: center;
        width: 40px;
        height: 40px;
        flex-shrink: 0;
        border-radius: 10px;
        background: #fff0f2;
        color: #a32638;
    }

    .order-delete-page .section-title {
        margin: 0;
        font-size: 16px;
        font-weight: 700;
    }

    .order-delete-page .delete-card-body {
        padding: 24px;
    }

    .order-delete-page .delete-alert {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin-bottom: 24px;
        padding: 16px;
        border: 1px solid #f1c5cb;
        border-radius: 10px;
        background: #fff3f4;
        color: #a32638;
        font-size: 14px;
        line-height: 1.7;
    }

    .order-delete-page .alert-icon {
        flex-shrink: 0;
        padding-top: 3px;
    }

    .order-delete-page .order-summary {
        margin: 0;
    }

    .order-delete-page .summary-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
        align-items: center;
        gap: 16px;
        padding: 18px 0;
    }

    .order-delete-page .summary-row + .summary-row {
        border-top: 1px solid #edf1f6;
    }

    .order-delete-page .summary-row dt {
        color: #52647c;
        font-size: 14px;
        font-weight: 600;
    }

    .order-delete-page .summary-row dd {
        margin: 0;
        font-size: 14px;
        overflow-wrap: anywhere;
    }

    .order-delete-page .order-id {
        font-weight: 700;
        font-variant-numeric: tabular-nums;
    }

    .order-delete-page .status-badge {
        display: inline-block;
        padding: 5px 10px;
        border: 1px solid #d6e1ef;
        border-radius: 8px;
        background: #eef4fb;
        color: #285681;
        font-size: 12px;
        font-weight: 600;
        line-height: 1.5;
    }

    .order-delete-page .delete-form {
        margin: 0;
    }

    .order-delete-page .delete-card-footer {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 12px;
        padding: 18px 24px;
        border-top: 1px solid #e6ecf3;
        background: #f8fafc;
    }

    .order-delete-page .action-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-width: 120px;
        min-height: 44px;
        padding: 10px 20px;
        border: 1px solid;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 700;
    }

    .order-delete-page .delete-button {
        border-color: #b52b40;
        background: #b52b40;
        color: #fff;
    }

    .order-delete-page .delete-button:hover,
    .order-delete-page .delete-button:active {
        border-color: #962235;
        background: #962235;
        color: #fff;
    }

    .order-delete-page .cancel-button {
        border-color: #d6e1ef;
        background: #fff;
        color: #42566f;
    }

    .order-delete-page .cancel-button:hover,
    .order-delete-page .cancel-button:active {
        border-color: #bccbdd;
        background: #eef4fb;
        color: #24364d;
    }

    .order-delete-page .action-button:focus-visible {
        outline: 3px solid #278575;
        outline-offset: 3px;
        box-shadow: none;
    }

    @@media (max-width: 575.98px) {
        .order-delete-page .delete-card-header,
        .order-delete-page .delete-card-body,
        .order-delete-page .delete-card-footer {
            padding: 20px;
        }

        .order-delete-page .action-button {
            width: 100%;
        }
    }
</style>

<div class="order-delete-page">
    <h1 class="page-title">Delete Order</h1>

    <div class="delete-card">
        <div class="delete-card-header">
            <span class="section-icon" aria-hidden="true">
                <i class="fas fa-trash-can"></i>
            </span>

            <h2 class="section-title">Confirm Deletion</h2>
        </div>

        <div class="delete-card-body">
            <div class="delete-alert" role="alert">
                <span class="alert-icon" aria-hidden="true">
                    <i class="fas fa-triangle-exclamation"></i>
                </span>

                <span>
                    Are you sure you want to delete this order?
                </span>
            </div>

            <dl class="order-summary">
                <div class="summary-row">
                    <dt>Order ID</dt>
                    <dd class="order-id">@Model.OrderID</dd>
                </div>

                <div class="summary-row">
                    <dt>Status</dt>
                    <dd>
                        <span class="status-badge">@Model.Status</span>
                    </dd>
                </div>
            </dl>
        </div>

        <form asp-action="Delete" class="delete-form">
            <input asp-for="OrderID" hidden />

            <div class="delete-card-footer">
                <button type="submit"
                        class="btn action-button delete-button">
                    <i class="fas fa-trash-can" aria-hidden="true"></i>
                    Delete
                </button>

                <a asp-action="Index"
                   class="btn action-button cancel-button">
                    <i class="fas fa-xmark" aria-hidden="true"></i>
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>