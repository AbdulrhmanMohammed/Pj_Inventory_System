<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>@ViewData["Title"] - Pj_Inventory_System</title>

    <link href="https://cdn.jsdelivr.net/npm/simple-datatables@7.1.2/dist/style.min.css" rel="stylesheet" />
    <link href="~/tempboot/css/styles.css" rel="stylesheet" />
    <script src="https://use.fontawesome.com/releases/v6.3.0/js/all.js" crossorigin="anonymous"></script>
    <style>
            .inventory-layout {
                --inventory-ink: #17263a;
                --inventory-muted: #516279;
                --inventory-canvas: #f4f7fb;
                --inventory-line: #dde5ef;
                --inventory-sidebar: #111e30;
                --inventory-accent: #7ce3d0;
                background: var(--inventory-canvas);
            }

            .inventory-layout .inventory-topbar {
                background: #142338;
                box-shadow: inset 0 -1px rgba(255, 255, 255, .1);
            }

            .inventory-layout .navbar-brand {
                display: flex;
                align-items: center;
                gap: .625rem;
                color: #fff;
                font-size: .9375rem;
                font-weight: 700;
                letter-spacing: -.015em;
            }

            .inventory-layout .inventory-brand-mark {
                display: grid;
                width: 2rem;
                height: 2rem;
                flex: 0 0 2rem;
                place-items: center;
                border-radius: .625rem;
                background: var(--inventory-accent);
                color: #123a36;
            }

            .inventory-layout #sidebarToggle,
            .inventory-layout #navbarDropdown {
                border-radius: .5rem;
                color: #e0e9f4;
            }

            .inventory-layout #sidebarToggle {
                width: 2.25rem;
                height: 2.25rem;
            }

            .inventory-layout #sidebarToggle:hover,
            .inventory-layout #navbarDropdown:hover,
            .inventory-layout #navbarDropdown[aria-expanded="true"] {
                background: #263a53;
                color: #fff;
            }

            .inventory-layout .inventory-topbar .dropdown-menu {
                padding: .375rem;
                border: 1px solid var(--inventory-line);
                border-radius: .75rem;
                box-shadow: 0 10px 28px rgba(20, 35, 56, .16);
            }

            .inventory-layout .inventory-topbar .dropdown-item {
                padding: .5rem .75rem;
                border-radius: .375rem;
            }

            .inventory-layout .inventory-sidebar {
                background: var(--inventory-sidebar);
            }

            .inventory-layout .inventory-sidebar .sb-sidenav-menu {
                padding: .25rem .75rem 1rem;
            }

            .inventory-layout .inventory-sidebar .sb-sidenav-menu-heading {
                padding: 1.25rem .625rem .5rem;
                color: #a4b5cb;
                font-size: .6875rem;
                letter-spacing: .11em;
            }

            .inventory-layout .inventory-sidebar .nav-link {
                min-height: 2.5rem;
                margin-bottom: .1875rem;
                padding: .5rem .625rem;
                border-radius: .5rem;
                color: #e2eaf5;
                font-size: .875rem;
                font-weight: 500;
            }

            .inventory-layout .inventory-sidebar .sb-nav-link-icon {
                width: 1.25rem;
                margin-right: .625rem;
                color: var(--inventory-accent);
                text-align: center;
            }

            .inventory-layout .inventory-sidebar .nav-link:hover,
            .inventory-layout .inventory-sidebar .nav-link:focus-visible {
                background: #22364e;
                color: #fff;
            }

            .inventory-layout .inventory-sidebar .sb-sidenav-footer {
                display: flex;
                align-items: center;
                gap: .625rem;
                padding: .875rem 1rem;
                border-top: 1px solid #293b52;
                background: #16263a;
                color: #fff;
                font-size: .875rem;
            }

            .inventory-layout .inventory-account-icon {
                display: grid;
                width: 2.125rem;
                height: 2.125rem;
                flex: 0 0 2.125rem;
                place-items: center;
                border-radius: .625rem;
                background: #253b52;
                color: var(--inventory-accent);
            }

            .inventory-layout .inventory-sidebar .sb-sidenav-footer .small {
                color: #b5c5d9;
            }

            .inventory-layout .inventory-main {
                padding-block: clamp(1rem, 2vw, 1.75rem);
                background: var(--inventory-canvas);
            }

            .inventory-layout .inventory-footer {
                padding-block: 1rem;
                border-top: 1px solid var(--inventory-line);
                background: #fff;
                color: var(--inventory-muted);
            }

            .inventory-layout .inventory-footer a {
                color: #25587d;
                text-decoration: underline;
                text-underline-offset: .16em;
            }

            .inventory-layout .inventory-topbar :focus-visible,
            .inventory-layout .inventory-sidebar :focus-visible,
            .inventory-layout .inventory-footer :focus-visible {
                outline: 2px solid #4e92e6;
                outline-offset: 2px;
            }

            @@media (max-width: 575.98px) {
                .inventory-layout .navbar-brand {
                    width: auto;
                    margin-right: .5rem;
                }

                .inventory-layout #sidebarToggle {
                    flex: 0 0 2.25rem;
                }
            }
    </style>
</head>

<body class="sb-nav-fixed inventory-layout">

    <!-- Navbar -->
    <nav class="sb-topnav navbar navbar-expand navbar-dark inventory-topbar">
        <a class="navbar-brand ps-3" asp-controller="Home" asp-action="Index">
            <span class="inventory-brand-mark" aria-hidden="true"><i class="fas fa-cubes"></i></span>
            <span>Inventory System</span>
        </a>

        <button class="btn btn-link btn-sm me-2 me-sm-4" id="sidebarToggle" type="button" aria-label="Toggle sidebar" aria-controls="layoutSidenav_nav">
            <i class="fas fa-bars"></i>
        </button>

        <ul class="navbar-nav ms-auto me-3 me-lg-4">
            <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle" id="navbarDropdown" href="#" data-bs-toggle="dropdown" aria-label="Account menu" aria-expanded="false">
                    <i class="fas fa-user fa-fw"></i>
                </a>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><a class="dropdown-item" href="#">Settings</a></li>
                    <li><a class="dropdown-item" href="#">Activity Log</a></li>
                    <li><hr class="dropdown-divider" /></li>
                    <li><a class="dropdown-item" href="#">Logout</a></li>
                </ul>
            </li>
        </ul>
    </nav>

    <div id="layoutSidenav">

        <!-- Sidebar -->
        <div id="layoutSidenav_nav">
            <nav class="sb-sidenav accordion sb-sidenav-dark inventory-sidebar">

                <div class="sb-sidenav-menu">
                    <div class="nav">

                        <div class="sb-sidenav-menu-heading">Main</div>

                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            <div class="sb-nav-link-icon"><i class="fas fa-home"></i></div>
                            Dashboard
                        </a>

                        <div class="sb-sidenav-menu-heading">Management</div>

                        <a class="nav-link" asp-controller="Category" asp-action="Index">
                            <div class="sb-nav-link-icon"><i class="fas fa-tags"></i></div>
                            Categories
                        </a>

                        <a class="nav-link" asp-controller="Product" asp-action="Index">
                            <div class="sb-nav-link-icon"><i class="fas fa-box"></i></div>
                            Products
                        </a>

                        <a class="nav-link" asp-controller="Supplier" asp-action="Index">
                            <div class="sb-nav-link-icon"><i class="fas fa-truck"></i></div>
                            Suppliers
                        </a>

                        <a class="nav-link" asp-controller="StockIn" asp-action="Index">
                            <div class="sb-nav-link-icon"><i class="fas fa-arrow-down"></i></div>
                            Stock In
                        </a>

                        <a class="nav-link" asp-controller="StockOut" asp-action="Index">
                            <div class="sb-nav-link-icon"><i class="fas fa-arrow-up"></i></div>
                            Stock Out
                        </a>

                        <div class="sb-sidenav-menu-heading">System</div>

                        <a class="nav-link" asp-controller="Roles" asp-action="Index">
                            <div class="sb-nav-link-icon"><i class="fas fa-user-shield"></i></div>
                            Roles
                        </a>

                        <a class="nav-link" asp-controller="Orders" asp-action="Index">
                            <div class="sb-nav-link-icon"><i class="fas fa-clipboard-list"></i></div>
                            Orders
                        </a>

                        <a class="nav-link" asp-controller="Permissions" asp-action="Index">
                            <div class="sb-nav-link-icon"><i class="fas fa-key"></i></div>
                            Permissions
                        </a>

                        <a class="nav-link" asp-controller="Users" asp-action="Index">
                            <div class="sb-nav-link-icon"><i class="fas fa-users"></i></div>
                            Users
                        </a>

                    </div>
                </div>

                <div class="sb-sidenav-footer">
                    <span class="inventory-account-icon" aria-hidden="true"><i class="fas fa-user"></i></span>
                    <div>
                        <div class="small">Logged in as:</div>
                        <span class="fw-semibold">Admin</span>
                    </div>
                </div>

            </nav>
        </div>

        <!-- Main Content -->
        <div id="layoutSidenav_content">
            <main class="inventory-main">
                <div class="container-fluid px-3 px-lg-4">
                    @RenderBody()
                </div>
            </main>

            <footer class="inventory-footer mt-auto">
                <div class="container-fluid px-3 px-lg-4 d-flex flex-wrap align-items-center justify-content-between gap-2 small">
                    <div>© Inventory System 2026</div>
                    <div>
                        <a href="#">Privacy Policy</a> &middot;
                        <a href="#">Terms & Conditions</a>
                    </div>
                </div>
            </footer>
        </div>

    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/tempboot/js/scripts.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
