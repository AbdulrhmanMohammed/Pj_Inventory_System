@model IEnumerable<Pj_Inventory_System.Application.Dtos.CategoryDtos.CategoryDto>

@{
    ViewData["Title"] = "Category Page";
}

<style>
    .categories-page {
        color: #17263a;
    }

    .categories-page .page-header {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 24px;
    }

    .categories-page .page-title {
        margin: 0 0 6px;
        font-size: clamp(24px, 3vw, 30px);
        font-weight: 700;
        letter-spacing: -.6px;
    }

    .categories-page .page-description {
        margin: 0;
        color: #62738a;
        font-size: 14px;
    }

    .categories-page .create-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 44px;
        padding: 10px 18px;
        border: 1px solid #7ce3d0;
        border-radius: 10px;
        background: #7ce3d0;
        color: #123a36;
        font-size: 14px;
        font-weight: 700;
    }

    .categories-page .create-button:hover {
        border-color: #65d3be;
        background: #65d3be;
        color: #123a36;
    }

    .categories-page .table-card {
        overflow: hidden;
        border: 1px solid #dde5ef;
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 6px 24px rgba(20, 35, 56, .04);
    }

    .categories-page .table-card-header {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 20px 24px;
        border-bottom: 1px solid #e6ecf3;
    }

    .categories-page .table-icon {
        display: grid;
        place-items: center;
        width: 40px;
        height: 40px;
        flex-shrink: 0;
        border-radius: 10px;
        background: #e5f7f2;
        color: #226a5c;
    }

    .categories-page .table-card-title {
        margin: 0;
        font-size: 16px;
        font-weight: 700;
    }

    .categories-page .category-table {
        min-width: 560px;
        margin: 0;
        color: #17263a;
        vertical-align: middle;
    }

    .categories-page .category-table > thead > tr > th {
        padding: 14px 24px;
        border-bottom: 1px solid #e6ecf3;
        background: #f8fafc;
        color: #52647c;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: .05em;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .categories-page .category-table > tbody > tr > td {
        padding: 18px 24px;
        border-bottom: 1px solid #edf1f6;
        background: #fff;
        font-size: 14px;
    }

    .categories-page .category-table > tbody > tr:last-child > td {
        border-bottom: 0;
    }

    .categories-page .category-table > tbody > tr:hover > td {
        background: #f7fbfa;
    }

    .categories-page .category-id {
        color: #62738a;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }

    .categories-page .category-name {
        font-weight: 600;
        overflow-wrap: anywhere;
    }

    .categories-page .actions-column {
        text-align: right;
    }

    .categories-page .row-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 8px;
    }

    .categories-page .delete-form {
        margin: 0;
    }

    .categories-page .action-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        min-height: 38px;
        padding: 8px 12px;
        border: 1px solid;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        line-height: 1.4;
        white-space: nowrap;
    }

    .categories-page .edit-button {
        border-color: #d6e1ef;
        background: #eef4fb;
        color: #285681;
    }

    .categories-page .edit-button:hover {
        border-color: #b9cee5;
        background: #dfebf8;
        color: #20476c;
    }

    .categories-page .delete-button {
        border-color: #f1d4d9;
        background: #fff3f4;
        color: #a32638;
    }

    .categories-page .delete-button:hover {
        border-color: #e7b4be;
        background: #fbe3e7;
        color: #8a2030;
    }

    .categories-page .btn:focus-visible,
    .categories-page .table-responsive:focus-visible {
        outline: 3px solid #278575;
        outline-offset: 3px;
        box-shadow: none;
    }

    @@media (max-width: 575.98px) {
        .categories-page .create-button {
            width: 100%;
        }

        .categories-page .table-card-header {
            padding: 16px;
        }

        .categories-page .category-table > thead > tr > th,
        .categories-page .category-table > tbody > tr > td {
            padding: 14px 16px;
        }
    }
</style>

<div class="categories-page">
    <div class="page-header">
        <div>
            <h1 class="page-title">Categories</h1>
            <p class="page-description">
                Manage and organize your product categories.
            </p>
        </div>

        <a asp-action="Create" class="btn create-button">
            <i class="fas fa-plus" aria-hidden="true"></i>
            Create New Category
        </a>
    </div>

    <div class="table-card">
        <div class="table-card-header">
            <span class="table-icon" aria-hidden="true">
                <i class="fas fa-tags"></i>
            </span>

            <h2 class="table-card-title" id="categories-table-title">
                All Categories
            </h2>
        </div>

        <div class="table-responsive"
             role="region"
             aria-labelledby="categories-table-title"
             tabindex="0">
            <table class="table category-table"
                   aria-labelledby="categories-table-title">
                <thead>
                    <tr>
                        <th scope="col">ID</th>
                        <th scope="col">Category Name</th>
                        <th scope="col" class="actions-column">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var category in Model)
                    {
                        <tr>
                            <td class="category-id">@category.CategoryID</td>
                            <td class="category-name">@category.CategoryName</td>

                            <td>
                                <div class="row-actions">
                                    <a asp-action="Edit"
                                       asp-route-uid="@category.UID"
                                       class="btn action-button edit-button">
                                        <i class="fas fa-pen" aria-hidden="true"></i>
                                        Edit
                                    </a>

                                    <form asp-action="DeleteConfirmed"
                                          asp-route-uid="@category.UID"
                                          method="post"
                                          class="delete-form"
                                          onsubmit="return confirm('Are you sure you want to delete this category?');">
                                        <button type="submit"
                                                class="btn action-button delete-button">
                                            <i class="fas fa-trash-can"
                                               aria-hidden="true"></i>
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>