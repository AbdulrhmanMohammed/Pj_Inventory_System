@model Pj_Inventory_System.Application.Dtos.CategoryDtos.UpdateCategoryDto

<style>
    .category-edit-page {
        max-width: 760px;
        margin: 0 auto;
        color: #17263a;
    }

    .category-edit-page .page-header {
        margin-bottom: 24px;
    }

    .category-edit-page .page-title {
        margin: 0 0 8px;
        font-size: clamp(24px, 3vw, 30px);
        font-weight: 700;
        letter-spacing: -.6px;
    }

    .category-edit-page .page-description {
        margin: 0;
        color: #62738a;
        font-size: 14px;
        line-height: 1.6;
    }

    .category-edit-page .edit-card {
        overflow: hidden;
        border: 1px solid #dde5ef;
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 6px 24px rgba(20, 35, 56, .04);
    }

    .category-edit-page .edit-card-header {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 20px 24px;
        border-bottom: 1px solid #e6ecf3;
    }

    .category-edit-page .section-icon {
        display: grid;
        place-items: center;
        width: 40px;
        height: 40px;
        flex-shrink: 0;
        border-radius: 10px;
        background: #e5f7f2;
        color: #226a5c;
    }

    .category-edit-page .section-title {
        margin: 0;
        font-size: 16px;
        font-weight: 700;
    }

    .category-edit-page .edit-form {
        margin: 0;
    }

    .category-edit-page .edit-card-body {
        padding: 28px 24px;
    }

    .category-edit-page .form-label {
        margin-bottom: 10px;
        color: #24364d;
        font-size: 14px;
        font-weight: 600;
    }

    .category-edit-page .form-control {
        min-height: 48px;
        padding: 12px 14px;
        border: 1px solid #d6dfeb;
        border-radius: 10px;
        background: #fbfcfe;
        color: #17263a;
        font-size: 15px;
    }

    .category-edit-page .form-control:focus {
        border-color: #278575;
        background: #fff;
        box-shadow: 0 0 0 4px rgba(39, 133, 117, .12);
    }

    .category-edit-page .form-control.input-validation-error {
        border-color: #b6384c;
    }

    .category-edit-page .edit-card-footer {
        display: flex;
        justify-content: flex-end;
        padding: 18px 24px;
        border-top: 1px solid #e6ecf3;
        background: #f8fafc;
    }

    .category-edit-page .save-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-width: 140px;
        min-height: 44px;
        padding: 10px 20px;
        border: 1px solid #7ce3d0;
        border-radius: 10px;
        background: #7ce3d0;
        color: #123a36;
        font-size: 14px;
        font-weight: 700;
    }

    .category-edit-page .save-button:hover,
    .category-edit-page .save-button:active {
        border-color: #65d3be;
        background: #65d3be;
        color: #123a36;
    }

    .category-edit-page .save-button:focus-visible {
        outline: 3px solid #278575;
        outline-offset: 3px;
        box-shadow: none;
    }

    @@media (max-width: 575.98px) {
        .category-edit-page .edit-card-header,
        .category-edit-page .edit-card-body,
        .category-edit-page .edit-card-footer {
            padding: 20px;
        }

        .category-edit-page .save-button {
            width: 100%;
        }
    }
</style>

<div class="category-edit-page">
    <div class="page-header">
        <h1 class="page-title">Edit Category</h1>
        <p class="page-description">
            Update the category details below.
        </p>
    </div>

    <div class="edit-card">
        <div class="edit-card-header">
            <span class="section-icon" aria-hidden="true">
                <i class="fas fa-tags"></i>
            </span>

            <h2 class="section-title">Category Details</h2>
        </div>

        <form method="post" asp-action="Edit" class="edit-form">

            <input type="hidden" asp-for="UID" />
            <input type="hidden" asp-for="CategoryID" />

            <div class="edit-card-body">
                <label asp-for="CategoryName" class="form-label">
                    Category Name
                </label>

                <input asp-for="CategoryName" class="form-control" />
            </div>

            <div class="edit-card-footer">
                <button type="submit" class="btn save-button">
                    <i class="fas fa-check" aria-hidden="true"></i>
                    Save
                </button>
            </div>

        </form>
    </div>
</div>