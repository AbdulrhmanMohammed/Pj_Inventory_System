@model IEnumerable<Pj_Inventory_System.Domain.Models.Role>

@{
    ViewData["Title"] = "Roles";
    int counter = 1;
}

<style>
    .roles-page {
        color: #17263a;
    }

    .roles-page .page-header {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 24px;
    }

    .roles-page .page-title {
        margin: 0 0 6px;
        font-size: clamp(24px, 3vw, 30px);
        font-weight: 700;
        letter-spacing: -.6px;
    }

    .roles-page .page-description {
        margin: 0;
        color: #62738a;
        font-size: 14px;
    }

    .roles-page .table-card {
        overflow: hidden;
        border: 1px solid #dde5ef;
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 6px 24px rgba(20, 35, 56, .04);
    }

    .roles-page .table-card-header {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 20px 24px;
        border-bottom: 1px solid #e6ecf3;
    }

    .roles-page .section-icon,
    .role-modal .section-icon {
        display: grid;
        place-items: center;
        width: 40px;
        height: 40px;
        flex-shrink: 0;
        border-radius: 10px;
        background: #e5f7f2;
        color: #226a5c;
    }

    .roles-page .section-title {
        margin: 0;
        font-size: 16px;
        font-weight: 700;
    }

    .roles-page .roles-table {
        min-width: 780px;
        margin: 0;
        color: #17263a;
        vertical-align: middle;
    }

    .roles-page .roles-table > thead > tr > th {
        padding: 14px 24px;
        border-bottom: 1px solid #e6ecf3;
        background: #f8fafc;
        color: #52647c;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: .05em;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .roles-page .roles-table > tbody > tr > td {
        padding: 18px 24px;
        border-bottom: 1px solid #edf1f6;
        background: #fff;
        font-size: 14px;
        overflow-wrap: anywhere;
    }

    .roles-page .roles-table > tbody > tr:last-child > td {
        border-bottom: 0;
    }

    .roles-page .roles-table > tbody > tr:hover > td {
        background: #f7fbfa;
    }

    .roles-page .number-cell {
        color: #62738a;
        font-variant-numeric: tabular-nums;
    }

    .roles-page .role-name {
        font-weight: 600;
    }

    .roles-page .actions-column {
        text-align: right;
    }

    .roles-page .row-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 8px;
    }

    .roles-page .btn,
    .role-modal .modal-footer .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 44px;
        padding: 10px 18px;
        border: 1px solid;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 600;
    }

    .roles-page .row-actions .btn {
        min-height: 38px;
        padding: 8px 12px;
        border-radius: 8px;
        font-size: 13px;
        white-space: nowrap;
    }

    .roles-page .create-button,
    .role-modal .save-button {
        border-color: #7ce3d0;
        background: #7ce3d0;
        color: #123a36;
    }

    .roles-page .create-button:hover,
    .role-modal .save-button:hover {
        border-color: #65d3be;
        background: #65d3be;
        color: #123a36;
    }

    .roles-page .assign-button {
        border-color: #c8e8df;
        background: #e5f7f2;
        color: #226a5c;
    }

    .roles-page .assign-button:hover {
        border-color: #a6d7ca;
        background: #d4efe6;
        color: #195345;
    }

    .roles-page .edit-button {
        border-color: #d6e1ef;
        background: #eef4fb;
        color: #285681;
    }

    .roles-page .edit-button:hover {
        border-color: #b9cee5;
        background: #dfebf8;
        color: #20476c;
    }

    .roles-page .delete-button {
        border-color: #f1d4d9;
        background: #fff3f4;
        color: #a32638;
    }

    .roles-page .delete-button:hover {
        border-color: #e7b4be;
        background: #fbe3e7;
        color: #8a2030;
    }

    .role-modal .modal-content {
        border: 1px solid #dde5ef;
        border-radius: 16px;
        background: #fff;
        color: #17263a;
        box-shadow: 0 20px 60px rgba(20, 35, 56, .18);
    }

    .role-modal form {
        margin: 0;
    }

    .role-modal .modal-header {
        gap: 12px;
        padding: 20px 24px;
        border-bottom: 1px solid #e6ecf3;
    }

    .role-modal .modal-title {
        margin: 0;
        font-size: 18px;
        font-weight: 700;
    }

    .role-modal .modal-body {
        padding: 24px;
        overflow-wrap: anywhere;
    }

    .role-modal .form-label {
        margin-bottom: 10px;
        color: #24364d;
        font-size: 14px;
        font-weight: 600;
    }

    .role-modal .form-control {
        min-height: 48px;
        padding: 12px 14px;
        border: 1px solid #d6dfeb;
        border-radius: 10px;
        background: #fbfcfe;
        color: #17263a;
        font-size: 15px;
    }

    .role-modal .form-control:focus {
        border-color: #278575;
        background: #fff;
        box-shadow: 0 0 0 4px rgba(39, 133, 117, .12);
    }

    .role-modal .modal-footer {
        gap: 8px;
        padding: 18px 24px;
        border-top: 1px solid #e6ecf3;
        border-radius: 0 0 16px 16px;
        background: #f8fafc;
    }

    .role-modal .cancel-button {
        border-color: #d6e1ef;
        background: #fff;
        color: #42566f;
    }

    .role-modal .cancel-button:hover {
        border-color: #bccbdd;
        background: #eef4fb;
        color: #24364d;
    }

    .role-modal .confirm-delete-button {
        border-color: #b52b40;
        background: #b52b40;
        color: #fff;
    }

    .role-modal .confirm-delete-button:hover {
        border-color: #962235;
        background: #962235;
        color: #fff;
    }

    .role-modal .delete-icon {
        background: #fff0f2;
        color: #a32638;
    }

    .role-modal .delete-message {
        margin: 0;
        padding: 16px;
        border: 1px solid #f1c5cb;
        border-radius: 10px;
        background: #fff3f4;
        color: #a32638;
        font-size: 14px;
        line-height: 1.8;
    }

    .roles-page .btn:focus-visible,
    .roles-page .table-responsive:focus-visible,
    .role-modal .btn:focus-visible,
    .role-modal .btn-close:focus-visible {
        outline: 3px solid #278575;
        outline-offset: 3px;
        box-shadow: none;
    }

    @@media (max-width: 575.98px) {
        .roles-page .create-button {
            width: 100%;
        }

        .roles-page .table-card-header,
        .role-modal .modal-header,
        .role-modal .modal-body,
        .role-modal .modal-footer {
            padding: 16px;
        }

        .roles-page .roles-table > thead > tr > th,
        .roles-page .roles-table > tbody > tr > td {
            padding: 14px 16px;
        }

        .role-modal .modal-footer .btn {
            flex: 1 1 120px;
        }
    }
</style>

<div class="roles-page">
    <div class="page-header">
        <div>
            <h1 class="page-title">Roles</h1>
            <p class="page-description">
                Manage roles and their assigned permissions.
            </p>
        </div>

        <button type="button"
                class="btn create-button"
                data-bs-toggle="modal"
                data-bs-target="#createModal">
            <i class="fas fa-plus" aria-hidden="true"></i>
            Create Role
        </button>
    </div>

    <div class="table-card">
        <div class="table-card-header">
            <span class="section-icon" aria-hidden="true">
                <i class="fas fa-user-shield"></i>
            </span>

            <h2 class="section-title" id="roles-table-title">
                Role List
            </h2>
        </div>

        <div class="table-responsive"
             role="region"
             aria-labelledby="roles-table-title"
             tabindex="0">
            <table class="table roles-table"
                   aria-labelledby="roles-table-title">
                <thead>
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">ID</th>
                        <th scope="col">Name</th>
                        <th scope="col" class="actions-column">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var role in Model)
                    {
                        <tr>
                            <td class="number-cell">@counter</td>
                            @{
                                counter++;
                            }

                            <td class="number-cell">@role.Id</td>
                            <td class="role-name">@role.Name</td>

                            <td>
                                <div class="row-actions">
                                    <a asp-controller="Roles"
                                       asp-action="AssignPermissions"
                                       asp-route-roleId="@role.Id"
                                       class="btn assign-button">
                                        <i class="fas fa-key" aria-hidden="true"></i>
                                        Assign Permissions
                                    </a>

                                    <button type="button"
                                            class="btn edit-button"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editModal-@role.Id">
                                        <i class="fas fa-pen" aria-hidden="true"></i>
                                        Edit
                                    </button>

                                    <button type="button"
                                            class="btn delete-button"
                                            data-bs-toggle="modal"
                                            data-bs-target="#deleteModal-@role.Id">
                                        <i class="fas fa-trash-can" aria-hidden="true"></i>
                                        Delete
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Create Modal -->
<div class="modal fade role-modal"
     id="createModal"
     tabindex="-1"
     aria-labelledby="createRoleTitle"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="Create" method="post">
                <div class="modal-header">
                    <span class="section-icon" aria-hidden="true">
                        <i class="fas fa-user-shield"></i>
                    </span>

                    <h2 class="modal-title" id="createRoleTitle">
                        Create Role
                    </h2>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>
                </div>

                <div class="modal-body">
                    <label for="createRoleName" class="form-label">
                        Role Name
                    </label>

                    <input id="createRoleName"
                           name="Name"
                           class="form-control"
                           placeholder="Enter role name" />
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn cancel-button"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit" class="btn save-button">
                        <i class="fas fa-plus" aria-hidden="true"></i>
                        Create
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@foreach (var role in Model)
{
    <!-- Edit Modal -->
    <div class="modal fade role-modal"
         id="editModal-@role.Id"
         tabindex="-1"
         aria-labelledby="editRoleTitle-@role.Id"
         aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form asp-action="Edit" method="post">
                    <input type="hidden" name="Id" value="@role.Id" />

                    <div class="modal-header">
                        <span class="section-icon" aria-hidden="true">
                            <i class="fas fa-pen"></i>
                        </span>

                        <h2 class="modal-title" id="editRoleTitle-@role.Id">
                            Edit Role
                        </h2>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Close">
                        </button>
                    </div>

                    <div class="modal-body">
                        <label for="editRoleName-@role.Id" class="form-label">
                            Role Name
                        </label>

                        <input type="text"
                               id="editRoleName-@role.Id"
                               name="Name"
                               value="@role.Name"
                               class="form-control" />
                    </div>

                    <div class="modal-footer">
                        <button type="button"
                                class="btn cancel-button"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <button type="submit" class="btn save-button">
                            <i class="fas fa-check" aria-hidden="true"></i>
                            Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Delete Modal -->
    <div class="modal fade role-modal"
         id="deleteModal-@role.Id"
         tabindex="-1"
         aria-labelledby="deleteRoleTitle-@role.Id"
         aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form asp-action="Delete" method="post">
                    <input type="hidden" name="id" value="@role.Id" />

                    <div class="modal-header">
                        <span class="section-icon delete-icon" aria-hidden="true">
                            <i class="fas fa-trash-can"></i>
                        </span>

                        <h2 class="modal-title" id="deleteRoleTitle-@role.Id">
                            Delete Role
                        </h2>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Close">
                        </button>
                    </div>

                    <div class="modal-body">
                        <p class="delete-message">
                            Are you sure you want to delete
                            <strong>@role.Name</strong>?
                        </p>
                    </div>

                    <div class="modal-footer">
                        <button type="button"
                                class="btn cancel-button"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <button type="submit" class="btn confirm-delete-button">
                            <i class="fas fa-trash-can" aria-hidden="true"></i>
                            Delete
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}