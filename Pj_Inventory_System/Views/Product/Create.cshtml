@model Pj_Inventory_System.Application.Dtos.ProductDtos.CreateProductDto

<style>
    .product-create-page {
        max-width: 960px;
        margin: 0 auto;
        color: #17263a;
    }

    .product-create-page .page-header {
        margin-bottom: 24px;
    }

    .product-create-page .page-title {
        margin: 0 0 8px;
        font-size: clamp(24px, 3vw, 30px);
        font-weight: 700;
        letter-spacing: -.6px;
    }

    .product-create-page .page-description {
        margin: 0;
        color: #62738a;
        font-size: 14px;
        line-height: 1.6;
    }

    .product-create-page .create-card {
        overflow: hidden;
        border: 1px solid #dde5ef;
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 6px 24px rgba(20, 35, 56, .04);
    }

    .product-create-page .section-header {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 20px 24px;
        border-bottom: 1px solid #e6ecf3;
    }

    .product-create-page .section-icon {
        display: grid;
        place-items: center;
        width: 40px;
        height: 40px;
        flex-shrink: 0;
        border-radius: 10px;
        background: #e5f7f2;
        color: #226a5c;
    }

    .product-create-page .section-title {
        margin: 0;
        font-size: 16px;
        font-weight: 700;
    }

    .product-create-page .create-form {
        margin: 0;
    }

    .product-create-page .section-body {
        padding: 28px 24px;
    }

    .product-create-page .image-section {
        border-top: 1px solid #e6ecf3;
    }

    .product-create-page .form-label {
        margin-bottom: 10px;
        color: #24364d;
        font-size: 14px;
        font-weight: 600;
    }

    .product-create-page .form-control,
    .product-create-page .form-select {
        min-height: 48px;
        border: 1px solid #d6dfeb;
        border-radius: 10px;
        background-color: #fbfcfe;
        color: #17263a;
        font-size: 15px;
    }

    .product-create-page .form-control {
        padding: 12px 14px;
    }

    .product-create-page .form-select {
        padding: 12px 40px 12px 14px;
    }

    .product-create-page .form-control:focus,
    .product-create-page .form-select:focus {
        border-color: #278575;
        background-color: #fff;
        box-shadow: 0 0 0 4px rgba(39, 133, 117, .12);
    }

    .product-create-page .input-validation-error {
        border-color: #b6384c;
    }

    .product-create-page .form-control[type="file"] {
        padding: 10px 14px;
    }

    .product-create-page .form-control[type="file"]::file-selector-button {
        margin: -10px 14px -10px -14px;
        padding: 12px 14px;
        border: 0;
        border-right: 1px solid #d6dfeb;
        background: #eef4fb;
        color: #285681;
        font-weight: 600;
        cursor: pointer;
    }

    .product-create-page .form-control[type="file"]:hover::file-selector-button {
        background: #dfebf8;
    }

    .product-create-page .card-actions {
        display: flex;
        justify-content: flex-end;
        padding: 18px 24px;
        border-top: 1px solid #e6ecf3;
        background: #f8fafc;
    }

    .product-create-page .create-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-width: 140px;
        min-height: 44px;
        padding: 10px 20px;
        border: 1px solid #7ce3d0;
        border-radius: 10px;
        background: #7ce3d0;
        color: #123a36;
        font-size: 14px;
        font-weight: 700;
    }

    .product-create-page .create-button:hover,
    .product-create-page .create-button:active {
        border-color: #65d3be;
        background: #65d3be;
        color: #123a36;
    }

    .product-create-page .create-button:focus-visible {
        outline: 3px solid #278575;
        outline-offset: 3px;
        box-shadow: none;
    }

    @@media (max-width: 575.98px) {
        .product-create-page .section-header,
        .product-create-page .section-body,
        .product-create-page .card-actions {
            padding: 20px;
        }

        .product-create-page .create-button {
            width: 100%;
        }
    }
</style>

<div class="product-create-page">
    <div class="page-header">
        <h1 class="page-title">Create Product</h1>
        <p class="page-description">
            Enter the product details, stock, and image.
        </p>
    </div>

    <div class="create-card">
        <form method="post"
              asp-action="Create"
              enctype="multipart/form-data"
              class="create-form">

            <section aria-labelledby="product-details-title">
                <div class="section-header">
                    <span class="section-icon" aria-hidden="true">
                        <i class="fas fa-box"></i>
                    </span>

                    <h2 class="section-title" id="product-details-title">
                        Product Details
                    </h2>
                </div>

                <div class="section-body">
                    <div class="row g-4">
                        <div class="col-12">
                            <label asp-for="ProductName" class="form-label">
                                Product Name
                            </label>
                            <input asp-for="ProductName" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CategoryID" class="form-label">
                                Category
                            </label>
                            <select asp-for="CategoryID"
                                    class="form-select"
                                    asp-items="ViewBag.Categories">
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="SupplierID" class="form-label">
                                Supplier
                            </label>
                            <select asp-for="SupplierID"
                                    class="form-select"
                                    asp-items="ViewBag.Suppliers">
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="QuantityInStock" class="form-label">
                                Quantity
                            </label>
                            <input asp-for="QuantityInStock"
                                   class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="UnitPrice" class="form-label">
                                Unit Price
                            </label>
                            <input asp-for="UnitPrice" class="form-control" />
                        </div>
                    </div>
                </div>
            </section>

            <section class="image-section"
                     aria-labelledby="product-image-title">
                <div class="section-header">
                    <span class="section-icon" aria-hidden="true">
                        <i class="fas fa-image"></i>
                    </span>

                    <h2 class="section-title" id="product-image-title">
                        Product Image
                    </h2>
                </div>

                <div class="section-body">
                    <label for="productImage" class="form-label">
                        Image
                    </label>
                    <input type="file"
                           id="productImage"
                           name="image"
                           class="form-control" />
                </div>
            </section>

            <div class="card-actions">
                <button type="submit" class="btn create-button">
                    <i class="fas fa-plus" aria-hidden="true"></i>
                    Create
                </button>
            </div>
        </form>
    </div>
</div>