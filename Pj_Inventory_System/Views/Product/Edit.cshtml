@model Pj_Inventory_System.Application.Dtos.ProductDtos.UpdateProductDto

<style>
    .product-edit-page {
        max-width: 960px;
        margin: 0 auto;
        color: #17263a;
    }

    .product-edit-page .page-header {
        margin-bottom: 24px;
    }

    .product-edit-page .page-title {
        margin: 0 0 8px;
        font-size: clamp(24px, 3vw, 30px);
        font-weight: 700;
        letter-spacing: -.6px;
    }

    .product-edit-page .page-description {
        margin: 0;
        color: #62738a;
        font-size: 14px;
        line-height: 1.6;
    }

    .product-edit-page .edit-card {
        overflow: hidden;
        border: 1px solid #dde5ef;
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 6px 24px rgba(20, 35, 56, .04);
    }

    .product-edit-page .section-header {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 20px 24px;
        border-bottom: 1px solid #e6ecf3;
    }

    .product-edit-page .section-icon {
        display: grid;
        place-items: center;
        width: 40px;
        height: 40px;
        flex-shrink: 0;
        border-radius: 10px;
        background: #e5f7f2;
        color: #226a5c;
    }

    .product-edit-page .section-title {
        margin: 0;
        font-size: 16px;
        font-weight: 700;
    }

    .product-edit-page .edit-form {
        margin: 0;
    }

    .product-edit-page .section-body {
        padding: 28px 24px;
    }

    .product-edit-page .image-section {
        border-top: 1px solid #e6ecf3;
    }

    .product-edit-page .form-label {
        margin-bottom: 10px;
        color: #24364d;
        font-size: 14px;
        font-weight: 600;
    }

    .product-edit-page .form-control,
    .product-edit-page .form-select {
        min-height: 48px;
        border: 1px solid #d6dfeb;
        border-radius: 10px;
        background-color: #fbfcfe;
        color: #17263a;
        font-size: 15px;
    }

    .product-edit-page .form-control {
        padding: 12px 14px;
    }

    .product-edit-page .form-select {
        padding: 12px 40px 12px 14px;
    }

    .product-edit-page .form-control:focus,
    .product-edit-page .form-select:focus {
        border-color: #278575;
        background-color: #fff;
        box-shadow: 0 0 0 4px rgba(39, 133, 117, .12);
    }

    .product-edit-page .input-validation-error {
        border-color: #b6384c;
    }

    .product-edit-page .image-fields {
        display: grid;
        grid-template-columns: 170px minmax(0, 1fr);
        align-items: center;
        gap: 28px;
    }

    .product-edit-page .current-image {
        display: block;
        width: 150px;
        height: 150px;
        border: 1px solid #dde5ef;
        border-radius: 12px;
        background: #f8fafc;
        object-fit: cover;
    }

    .product-edit-page .image-placeholder {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 12px;
        width: 150px;
        height: 150px;
        padding: 12px;
        border: 1px dashed #cbd6e4;
        border-radius: 12px;
        background: #f8fafc;
        color: #62738a;
        text-align: center;
    }

    .product-edit-page .image-placeholder i,
    .product-edit-page .image-placeholder svg {
        font-size: 28px;
        color: #8295ad;
    }

    .product-edit-page .image-placeholder p {
        margin: 0;
        font-size: 12px;
    }

    .product-edit-page .upload-field {
        min-width: 0;
    }

    .product-edit-page .form-control[type="file"] {
        padding: 10px 14px;
    }

    .product-edit-page .form-control[type="file"]::file-selector-button {
        margin: -10px 14px -10px -14px;
        padding: 12px 14px;
        border: 0;
        border-right: 1px solid #d6dfeb;
        background: #eef4fb;
        color: #285681;
        font-weight: 600;
        cursor: pointer;
    }

    .product-edit-page .form-control[type="file"]:hover::file-selector-button {
        background: #dfebf8;
    }

    .product-edit-page .card-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 12px;
        padding: 18px 24px;
        border-top: 1px solid #e6ecf3;
        background: #f8fafc;
    }

    .product-edit-page .action-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 44px;
        padding: 10px 20px;
        border: 1px solid;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 700;
    }

    .product-edit-page .save-button {
        border-color: #7ce3d0;
        background: #7ce3d0;
        color: #123a36;
    }

    .product-edit-page .save-button:hover,
    .product-edit-page .save-button:active {
        border-color: #65d3be;
        background: #65d3be;
        color: #123a36;
    }

    .product-edit-page .cancel-button {
        border-color: #d6e1ef;
        background: #fff;
        color: #42566f;
    }

    .product-edit-page .cancel-button:hover,
    .product-edit-page .cancel-button:active {
        border-color: #bccbdd;
        background: #eef4fb;
        color: #24364d;
    }

    .product-edit-page .action-button:focus-visible {
        outline: 3px solid #278575;
        outline-offset: 3px;
        box-shadow: none;
    }

    @@media (max-width: 575.98px) {
        .product-edit-page .section-header,
        .product-edit-page .section-body,
        .product-edit-page .card-actions {
            padding: 20px;
        }

        .product-edit-page .image-fields {
            grid-template-columns: minmax(0, 1fr);
            gap: 24px;
        }

        .product-edit-page .action-button {
            width: 100%;
        }
    }
</style>

<div class="product-edit-page">
    <div class="page-header">
        <h1 class="page-title">Edit Product</h1>
        <p class="page-description">
            Update the product details, stock, and image.
        </p>
    </div>

    <div class="edit-card">
        <form method="post"
              asp-action="Edit"
              enctype="multipart/form-data"
              class="edit-form">

            <input type="hidden" asp-for="ProductID" />
            <input type="hidden" asp-for="UID" />

            <section aria-labelledby="product-details-title">
                <div class="section-header">
                    <span class="section-icon" aria-hidden="true">
                        <i class="fas fa-box"></i>
                    </span>
                    <h2 class="section-title" id="product-details-title">
                        Product Details
                    </h2>
                </div>

                <div class="section-body">
                    <div class="row g-4">
                        <div class="col-12">
                            <label asp-for="ProductName" class="form-label">
                                Product Name
                            </label>
                            <input asp-for="ProductName" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CategoryID" class="form-label">
                                Category
                            </label>
                            <select asp-for="CategoryID"
                                    class="form-select"
                                    asp-items="ViewBag.Categories">
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="SupplierID" class="form-label">
                                Supplier
                            </label>
                            <select asp-for="SupplierID"
                                    class="form-select"
                                    asp-items="ViewBag.Suppliers">
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="QuantityInStock" class="form-label">
                                Quantity In Stock
                            </label>
                            <input asp-for="QuantityInStock" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="UnitPrice" class="form-label">
                                Unit Price
                            </label>
                            <input asp-for="UnitPrice" class="form-control" />
                        </div>
                    </div>
                </div>
            </section>

            <section class="image-section"
                     aria-labelledby="product-image-title">
                <div class="section-header">
                    <span class="section-icon" aria-hidden="true">
                        <i class="fas fa-image"></i>
                    </span>
                    <h2 class="section-title" id="product-image-title">
                        Product Image
                    </h2>
                </div>

                <div class="section-body">
                    <div class="image-fields">
                        <div>
                            <div class="form-label">Current Image</div>

                            @if (!string.IsNullOrEmpty(Model.imageUrl))
                            {
                                <img src="@Model.imageUrl"
                                     alt="@Model.ProductName"
                                     class="current-image" />
                            }
                            else
                            {
                                <div class="image-placeholder">
                                    <i class="fas fa-image" aria-hidden="true"></i>
                                    <p>No Image Available</p>
                                </div>
                            }
                        </div>

                        <div class="upload-field">
                            <label for="productImage" class="form-label">
                                Upload New Image (Optional)
                            </label>
                            <input type="file"
                                   id="productImage"
                                   name="image"
                                   class="form-control" />
                        </div>
                    </div>
                </div>
            </section>

            <div class="card-actions">
                <button type="submit" class="btn action-button save-button">
                    <i class="fas fa-check" aria-hidden="true"></i>
                    Save Changes
                </button>

                <a asp-action="Index" class="btn action-button cancel-button">
                    <i class="fas fa-xmark" aria-hidden="true"></i>
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>