@model Pj_Inventory_System.Dtos.ProductDtos.UpdateProductDto

<h2>Edit Product</h2>

<form method="post" asp-action="Edit" enctype="multipart/form-data">

    <!-- مهم جداً: نرسل الـ ProductID -->
    <input type="hidden" asp-for="ProductID" />

    <!-- مهم جداً: نرسل الـ UID -->
    <input type="hidden" asp-for="UID" />

    <div class="mb-3">
        <label class="form-label">Product Name</label>
        <input asp-for="ProductName" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Category</label>
        <select asp-for="CategoryID" class="form-control" asp-items="ViewBag.Categories"></select>
    </div>

    <div class="mb-3">
        <label class="form-label">Supplier</label>
        <select asp-for="SupplierID" class="form-control" asp-items="ViewBag.Suppliers"></select>
    </div>

    <div class="mb-3">
        <label class="form-label">Quantity In Stock</label>
        <input asp-for="QuantityInStock" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Unit Price</label>
        <input asp-for="UnitPrice" class="form-control" />
    </div>

    <!-- عرض الصورة الحالية -->
    <div class="mb-3">
        <label class="form-label">Current Image</label><br />

        @if (!string.IsNullOrEmpty(Model.imageUrl))
        {
            <img src="@Model.imageUrl" style="width:150px; height:150px; object-fit:cover; border-radius:8px;" />
        }
        else
        {
            <p>No Image Available</p>
        }
    </div>

    <!-- رفع صورة جديدة -->
    <div class="mb-3">
        <label class="form-label">Upload New Image (Optional)</label>
        <input type="file" name="image" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>

</form>
